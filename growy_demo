<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<title>GrowDay Demo</title>

<style>
body{
margin:0;
font-family:-apple-system,BlinkMacSystemFont;
background:#f2f5f3;
}

.container{
max-width:420px;
margin:auto;
padding:15px;
}

.header{
background:white;
padding:15px;
border-radius:12px;
box-shadow:0 4px 10px rgba(0,0,0,0.05);
margin-bottom:15px;
}

.title{
font-size:22px;
font-weight:bold;
}

.subtitle{
color:#666;
font-size:14px;
margin-top:5px;
}

.stats{
margin-top:8px;
color:#666;
}

.card{
background:white;
padding:15px;
border-radius:12px;
margin-bottom:15px;
box-shadow:0 4px 10px rgba(0,0,0,0.05);
}

.farm{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
margin-top:10px;
}

.plot{
aspect-ratio:1;
background:#dff5df;
border-radius:10px;
display:flex;
align-items:center;
justify-content:center;
font-size:26px;
transition:0.2s;
cursor:pointer;
}

.plot:active{
transform:scale(0.9);
}

.task{
display:flex;
justify-content:space-between;
padding:10px;
background:#f7f7f7;
border-radius:8px;
margin-top:8px;
transition:0.3s;
}

/* 任务完成动画 */
@keyframes slideOut {
0% { transform: translateX(0); opacity:1; }
100% { transform: translateX(120px); opacity:0; }
}

.task.done{
animation: slideOut 0.4s forwards;
}

button{
background:#4CAF50;
border:none;
color:white;
padding:6px 10px;
border-radius:6px;
cursor:pointer;
}

button:active{
transform:scale(0.9);
}

input{
width:70%;
padding:8px;
border-radius:6px;
border:1px solid #ddd;
}

/* +10动画 */
.pop{
position:fixed;
left:50%;
top:50%;
transform:translateX(-50%);
font-size:22px;
color:#4CAF50;
opacity:1;
transition:1s;
pointer-events:none;
}
</style>
</head>

<body>

<div class="container">

<div class="header">
<div class="title">🌱 GrowDay</div>
<div class="subtitle">完成任务，让你的农场成长</div>
<div class="stats">
成长值：<span id="growth"></span> |
连续：<span id="streak"></span>天
</div>
</div>

<div class="card">
<h3>🌾 我的农场</h3>
<div class="farm" id="farm"></div>
</div>

<div class="card">
<h3>📋 今日任务</h3>

<input id="taskInput" placeholder="输入任务"/>
<button onclick="addTask()">添加</button>

<div id="tasks"></div>

</div>

</div>

<script>

// ===== 安全读取数据（已修复，保证不出错）=====
let growth, streak, tasks, farm;

// 读取成长值
let savedGrowth = localStorage.getItem("growth");
if (savedGrowth !== null && !isNaN(parseInt(savedGrowth))) {
    growth = parseInt(savedGrowth);
} else {
    growth = 30;
}

// 读取连续天数
let savedStreak = localStorage.getItem("streak");
if (savedStreak !== null && !isNaN(parseInt(savedStreak))) {
    streak = parseInt(savedStreak);
} else {
    streak = 0;
}

// 读取任务列表
let savedTasks = localStorage.getItem("tasks");
if (savedTasks !== null) {
    try {
        tasks = JSON.parse(savedTasks);
        if (!Array.isArray(tasks)) throw new Error();
    } catch(e) {
        tasks = ["完成一次学习","运动10分钟","阅读5页"];
    }
} else {
    tasks = ["完成一次学习","运动10分钟","阅读5页"];
}

// 读取农场数据（关键修复）
let savedFarm = localStorage.getItem("farm");
if (savedFarm !== null) {
    try {
        farm = JSON.parse(savedFarm);
        if (!Array.isArray(farm) || farm.length !== 16) throw new Error();
    } catch(e) {
        farm = Array(16).fill(0);
    }
} else {
    farm = Array(16).fill(0);
}

// ===== 保存数据 =====
function save(){
    localStorage.setItem("growth", growth);
    localStorage.setItem("streak", streak);
    localStorage.setItem("tasks", JSON.stringify(tasks));
    localStorage.setItem("farm", JSON.stringify(farm));
}

// ===== 根据等级返回植物图标 =====
function getPlant(l){
    if(l==0) return "🌱";
    if(l==1) return "🌿";
    if(l==2) return "🌳";
    return "🌸";
}

// ===== 渲染农场 =====
function renderFarm(){
    let el = document.getElementById("farm");
    el.innerHTML = "";

    farm.forEach((l, i) => {
        let div = document.createElement("div");
        div.className = "plot";
        div.innerHTML = getPlant(l);

        div.onclick = () => {
            if(growth >= 20){
                farm[i]++;
                growth -= 20;
                animate(div);
                save();
                renderAll();
            }
        };

        el.appendChild(div);
    });
}

// 点击动画
function animate(el){
    el.style.transform = "scale(1.3)";
    setTimeout(() => { el.style.transform = "scale(1)"; }, 150);
}

// ===== 渲染任务列表 =====
function renderTasks(){
    let el = document.getElementById("tasks");
    el.innerHTML = "";

    tasks.forEach((t, i) => {
        let div = document.createElement("div");
        div.className = "task";
        div.id = "task-" + i;

        div.innerHTML = `
            <span>${escapeHtml(t)}</span>
            <button onclick="done(${i})">完成</button>
        `;

        el.appendChild(div);
    });
}

// 简单防止XSS
function escapeHtml(str) {
    return str.replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}

// 添加任务
function addTask(){
    let input = document.getElementById("taskInput");
    let val = input.value.trim();
    if(!val) return;

    tasks.push(val);
    input.value = "";
    save();
    renderAll();
}

// 完成任务（带动画）
function done(i){
    let el = document.getElementById("task-" + i);
    if (!el) return; // 防止重复点击
    el.classList.add("done");

    // 显示 +10 飘浮动画
    let pop = document.createElement("div");
    pop.className = "pop";
    pop.innerText = "+10 🌱";
    document.body.appendChild(pop);

    setTimeout(() => {
        pop.style.top = "30%";
        pop.style.opacity = "0";
    }, 50);

    setTimeout(() => {
        pop.remove();
    }, 1000);

    // 延迟删除任务并加成长值
    setTimeout(() => {
        tasks.splice(i, 1);
        growth += 10;
        streak++;
        save();
        renderAll();

        // 农场地块小动画
        document.querySelectorAll(".plot").forEach(p => {
            p.style.transform = "scale(1.1)";
            setTimeout(() => p.style.transform = "scale(1)", 150);
        });
    }, 400);
}

// ===== 刷新整个页面 =====
function renderAll(){
    document.getElementById("growth").innerText = growth;
    document.getElementById("streak").innerText = streak;
    renderFarm();
    renderTasks();
}

// 回车添加任务
document.getElementById("taskInput").addEventListener("keypress", function(e){
    if(e.key === "Enter") addTask();
});

// 开始渲染
renderAll();

</script>

</body>
</html>
